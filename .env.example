# Public backend URL embedded in the frontend build.
VITE_API_BASE_URL=https://sacscape-server.tail7d5063.ts.net

# Local application runtime used for Room Audio, LAN providers, settings, diagnostics, and Research Lab.
VITE_LOCAL_RUNTIME_URL=http://127.0.0.1:3001

# Optional local runtime port. The browser URL above must use the same port.
SACSCAPE_LOCAL_RUNTIME_PORT=3001

# Optional public Sonos Bridge port. The existing home-server service uses 3001.
SONOS_BRIDGE_PORT=3001

# Additional browser origin allowed by the backend CORS policy.
CLIENT_ORIGIN=http://localhost:5173

# Optional externally reachable backend base used in Sonos media stream URLs.
# Defaults to the origin receiving the synchronization request.
PUBLIC_API_BASE_URL=https://sacscape-server.tail7d5063.ts.net

# Optional server data root for persistent Sonos authorization.
# Defaults to C:\SACscapeData on Windows.
SACSCAPE_DATA_DIR=C:\SACscapeData
